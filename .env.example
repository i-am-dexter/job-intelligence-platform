# Backend
DATABASE_URL=postgresql+psycopg2://job_intel:job_intel@postgres:5432/job_intelligence
# For local dev without Docker/Postgres, comment the line above and uncomment:
# DATABASE_URL=sqlite:///./job_intelligence.db

# LLM provider for resume parsing/tailoring assistance -- all options work, none are required
# for the app to function (rule-based/template fallback is used if the LLM is unreachable).
#   ollama    - free, local, no API key. Default. Bundled as a docker-compose service.
#   groq      - free tier, cloud. Get a free key at https://console.groq.com (no credit card).
#   anthropic - paid. Optional upgrade for higher-quality extraction/tailoring.
#   none      - disable the LLM entirely, always use rule-based/template output.
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama. In Docker this is overridden to point at the bundled `ollama`
# service automatically -- these defaults are for running the backend outside Docker.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Used when LLM_PROVIDER=groq.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Used when LLM_PROVIDER=anthropic. Requires `pip install anthropic` (not installed by default).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

CORS_ORIGINS=["http://localhost:3000"]
RESUME_STORAGE_DIR=./storage/resumes

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Postgres (docker-compose)
POSTGRES_USER=job_intel
POSTGRES_PASSWORD=job_intel
POSTGRES_DB=job_intelligence
